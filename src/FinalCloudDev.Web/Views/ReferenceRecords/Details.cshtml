@model ReferenceRecord
@{
    ViewData["Title"] = Model.Title;
}

<p><a asp-action="Index">Back to records</a></p>
<h1>@Model.Title</h1>
<p class="lede">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes." : Model.Notes)</p>
<dl class="panel">
    <dt>Created</dt>
    <dd>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd>
    <dt>Updated</dt>
    <dd>@Model.UpdatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd>
</dl>
<div class="actions">
    <a class="btn btn-accent" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <form asp-action="Archive" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Archive this record?');">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-danger" type="submit">Archive</button>
    </form>
</div>
