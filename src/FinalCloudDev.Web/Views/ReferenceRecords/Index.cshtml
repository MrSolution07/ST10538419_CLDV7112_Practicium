@model IReadOnlyList<ReferenceRecord>
@{
    ViewData["Title"] = "Records";
    var search = ViewData["Search"] as string;
}

<div class="toolbar">
    <div>
        <h1>Records</h1>
        <p class="lede">Reference module. Copy this list, form, and service when the brief names a real entity.</p>
    </div>
    <a class="btn btn-accent" asp-action="Create">New record</a>
</div>

<form class="search-form" method="get" role="search">
    <label class="visually-hidden" for="q">Search title</label>
    <input class="form-control" id="q" name="q" value="@search" placeholder="Search title" />
    <button class="btn btn-outline-secondary" type="submit">Search</button>
</form>

<div class="panel table-wrap">
    @if (Model.Count == 0)
    {
        <p class="empty">No records yet. Create the first one, or clear the search.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Updated</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@record.Id">@record.Title</a></td>
                    <td>@record.UpdatedAt.ToString("dd MMM yyyy HH:mm") UTC</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@record.Id">Edit</a>
                        <form asp-action="Archive" asp-route-id="@record.Id" method="post" onsubmit="return confirm('Archive this record?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-link p-0" type="submit">Archive</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
