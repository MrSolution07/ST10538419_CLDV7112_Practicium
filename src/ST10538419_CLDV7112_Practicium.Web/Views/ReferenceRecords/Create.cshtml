@model ReferenceRecordForm
@{
    ViewData["Title"] = "New record";
}

<h1>New record</h1>
<p class="lede">Titles are required. Notes are optional.</p>

<form asp-action="Create" method="post" class="panel" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <partial name="_RecordForm" model="Model" />
    <div class="actions">
        <button class="btn btn-accent" type="submit">Save</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
