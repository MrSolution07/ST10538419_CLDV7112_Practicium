@model ReferenceRecordForm
@{
    ViewData["Title"] = "Edit record";
}

<h1>Edit record</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <partial name="_RecordForm" model="Model" />
    <div class="actions">
        <button class="btn btn-accent" type="submit">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
