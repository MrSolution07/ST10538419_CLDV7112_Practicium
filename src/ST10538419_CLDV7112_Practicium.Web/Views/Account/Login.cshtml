@model LoginForm
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-layout">
    <form asp-action="Login" method="post" class="panel auth-card" novalidate>
        <h1>Sign in</h1>
        <p class="lede">ArgiStream IoT keeps soil readings, drone images, and irrigation commands for commercial farms.</p>
        <partial name="_FormErrors" />
        <div class="mb-3">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <button class="btn btn-accent" type="submit">Sign in</button>
        <section class="tester" aria-label="Tester accounts">
            <h2>Tester accounts</h2>
            <p>Use one of these accounts, then click Sign in.</p>
            <ul class="tester-list">
                @foreach (var account in DemoAccounts.All)
                {
                    <li>
                        <span><strong>@account.Username</strong> / @account.Password</span>
                        <button class="btn btn-line tester-button" type="button" data-fill-user="@account.Username" data-fill-password="@account.Password">Use @account.Role</button>
                    </li>
                }
            </ul>
        </section>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
