@model DeviceForm
@{
    ViewData["Title"] = "Edit device";
}

<h1>Edit device</h1>
<p class="lede">The queue function can change operational status after a command is processed.</p>

<form asp-action="Edit" method="post" class="panel" novalidate>
    <partial name="_FormErrors" />
    <partial name="_DeviceFields" model="Model" />
    <div class="actions">
        <button class="btn btn-accent" type="submit">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
