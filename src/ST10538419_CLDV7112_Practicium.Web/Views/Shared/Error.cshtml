@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1>Something went wrong</h1>
<p class="lede">The request could not be completed. Try the page again. If you are signing in, use one of the tester accounts on the sign-in page.</p>

@if (Model.ShowRequestId)
{
    <p><span class="status-label">Request ID</span> <code>@Model.RequestId</code></p>
}
